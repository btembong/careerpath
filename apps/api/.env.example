# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/careerpathafrica"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Production: generate with `openssl rand -hex 32`. The API refuses to start with a default/short value
# when NODE_ENV=production. The portal's JWT_SECRET (apps/portal/.env.local) must be identical.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ─── WordPress Bridge ─────────────────────────────────────────────────────────
# URL of the live WordPress site (no trailing slash)
WP_URL="https://your-wordpress-site.com"
# Shared secret — must match CPA_BRIDGE_SECRET in wp-config.php
WP_BRIDGE_SECRET="change-me-to-a-long-random-string"
# WordPress Application Password for REST API user creation
# Create at: WP Admin → Users → Edit User → Application Passwords
WP_APP_USER="api-bot"
WP_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# ─── Daily.co (live classes) ──────────────────────────────────────────────────
DAILY_API_KEY="your-daily-api-key"
# Base URL — usually https://api.daily.co/v1
DAILY_API_URL="https://api.daily.co/v1"

# ─── Cloudflare R2 (file uploads) ─────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="careerpathafrica"
# Public CDN URL for the bucket (enable public access in R2 settings)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# ─── Paystack (NGN / GHS / ZAR / KES / EGP / USD) ────────────────────────────
PAYSTACK_SECRET_KEY="your_paystack_secret_key"
# Webhook secret — set in Paystack dashboard → API Keys & Webhooks
PAYSTACK_WEBHOOK_SECRET="your-paystack-webhook-secret"
# Public key — used by the Next.js portal for the inline popup (not used by API)
# Set NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxx in your portal .env

# ─── Tranzak (XAF / XOF / RWF / UGX / TZS / MZN) ────────────────────────────
TRANZAK_APP_ID="your-tranzak-app-id"
TRANZAK_APP_KEY="your-tranzak-app-key"
# Base URL — https://dsapi.tranzak.me (production) or sandbox equivalent
TRANZAK_BASE_URL="https://dsapi.tranzak.me"
# Auth key set in Tranzak dashboard → Webhooks → Auth Key
# Compared against authKey field inside the webhook JSON body
TRANZAK_WEBHOOK_AUTH_KEY="your-tranzak-webhook-auth-key"

# ─── Portal ──────────────────────────────────────────────────────────────────
# Full URL of the Next.js portal — used for payment redirect URLs
PORTAL_URL="https://portal.yoursite.com"

# ─── Brevo (transactional email) ──────────────────────────────────────────────
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_SENDER_EMAIL="noreply@careerpathafrica.com"
BREVO_SENDER_NAME="CareerPath Africa"

# ─── Misc ─────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3001

# Local demo logins that bypass WordPress (never used when NODE_ENV=production).
# Format: email:password:ROLE,email:password:ROLE  (ROLE = ADMIN | TEACHER | STUDENT)
DEMO_ACCOUNTS=""

# AI tutor and question drafting (Claude). Without a key the tutor says it isn't set up yet.
ANTHROPIC_API_KEY=""
# Optional: override the model (defaults to claude-opus-5-5)
AI_MODEL=""
