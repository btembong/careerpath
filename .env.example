# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://cpa_user:cpa_password@localhost:5432/cpa_db"

# ── NestJS ────────────────────────────────────────────────
PORT=3001
PORTAL_URL=http://localhost:3000
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# ── WordPress ─────────────────────────────────────────────
WP_BASE_URL=https://careerpathafrica.com
WP_ADMIN_USER=your_wp_admin_username
WP_ADMIN_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_BRIDGE_SECRET=change_me_in_production

# ── Daily.co ──────────────────────────────────────────────
DAILY_API_KEY=your_daily_api_key
DAILY_DOMAIN=your-domain.daily.co

# ── File Storage (Cloudflare R2 / S3-compatible) ──────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=careerpathafrica-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Paystack (Nigeria · Ghana · South Africa) ─────────────
# Currencies: NGN, GHS, ZAR
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ── Tranzak (Cameroon · Central & West Africa) ────────────
# Currencies: XAF, XOF, RWF, UGX, TZS, MZN
# Get credentials at: https://developers.tranzak.me
TRANZAK_APP_ID=your_tranzak_app_id
TRANZAK_APP_KEY=your_tranzak_app_key
# Base URL for Tranzak API (production: https://dsapi.tranzak.me)
TRANZAK_BASE_URL=https://dsapi.tranzak.me
# Auth key from Tranzak dashboard → Webhooks → Auth Key
TRANZAK_WEBHOOK_AUTH_KEY=your_tranzak_webhook_auth_key

# ── Next.js (portal) ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Paystack PUBLIC key (safe to expose in browser — not the secret key)
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
