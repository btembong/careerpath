/// Default single-course price for a programme (null programme = every programme), applied by admins in bulk
model CoursePriceDefault {
  id          String     @id @default(uuid())
  programmeId String?
  currency    String
  amount      Int
  updatedAt   DateTime   @updatedAt
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, currency])
}

/// Platform-wide settings an admin can change, one JSON value per key (e.g. "pricing")
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Study time a student plans on their calendar
model StudyBlock {
  id           String      @id @default(uuid())
  studentId    String
  startsAt     DateTime
  durationMins Int         @default(60)
  topic        String
  courseId     String?
  done         Boolean     @default(false)
  createdAt    DateTime    @default(now())
  student      UserProfile @relation("StudentStudyBlocks", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, startsAt])
}

/// What a WordPress course category means on the portal; used to suggest tags when pulling courses
model WpCategoryMap {
  wpTermId    Int             @id
  name        String
  parentId    Int?
  courseCount Int             @default(0)
  programmeId String?
  subjectId   String?
  levelId     String?
  /// e.g. a country-level category that says nothing about the course itself
  ignored     Boolean         @default(false)
  /// AUTO = matched by name, ADMIN = set by an admin (never changed by later pulls)
  setBy       String          @default("AUTO")
  updatedAt   DateTime        @updatedAt
  programme   Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  subject     Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  level       EducationLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
}

/// One check or import of WordPress courses
/// One run of copying a course's content from Tutor LMS, queued and processed in the background
model TutorImport {
  id         String    @id @default(uuid())
  courseId   String
  wpCourseId Int
  /// QUEUED, RUNNING, DONE, FAILED, CANCELLED, or EDITED (stopped: teachers changed it on the portal)
  status     String    @default("QUEUED")
  /// Replace lessons even if teachers edited them on the portal
  force      Boolean   @default(false)
  /// What it's doing now, e.g. "Reading quizzes (2 of 3)"
  step       String?
  byId       String?
  /// Counts, the course outline and things for an admin to check
  summary    Json?
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([courseId, createdAt])
  @@index([status])
}

model WpPull {
  id        String       @id @default(uuid())
  createdAt DateTime     @default(now())
  byId      String?
  /// MANUAL check, IMPORT (changes brought in) or NIGHTLY check
  kind      String
  created   Int          @default(0)
  updated   Int          @default(0)
  hidden    Int          @default(0)
  archived  Int          @default(0)
  /// What the check found, e.g. { new: 5, changed: 3, same: 110, gone: 2 }
  found     Json?
  by        UserProfile? @relation(fields: [byId], references: [id], onDelete: SetNull)
}

/// A poll the teacher runs during a live class. OPEN: students answering · SHOWN: results shown to everyone · CLOSED
model ClassPoll {
  id          String          @id @default(uuid())
  liveClassId String
  question    String
  options     String[]
  status      String          @default("OPEN")
  createdAt   DateTime        @default(now())
  liveClass   LiveClass       @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  votes       ClassPollVote[]

  @@index([liveClassId])
}

model ClassPollVote {
  id        String    @id @default(uuid())
  pollId    String
  studentId String
  option    Int
  createdAt DateTime  @default(now())
  poll      ClassPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, studentId])
}

/// A question asked during a live class; kept on the class page afterwards. OPEN · LIVE (answered in class) · LATER · ANSWERED
model ClassQuestion {
  id          String              @id @default(uuid())
  liveClassId String
  authorId    String
  anonymous   Boolean             @default(false)
  body        String
  answer      String?
  state       String              @default("OPEN")
  createdAt   DateTime            @default(now())
  answeredAt  DateTime?
  liveClass   LiveClass           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  votes       ClassQuestionVote[]

  @@index([liveClassId])
}

model ClassQuestionVote {
  id         String        @id @default(uuid())
  questionId String
  userId     String
  question   ClassQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

/// A few questions from the teacher's question bank, answered by everyone at once; each student's answers are a Test Centre practice session
model ClassQuiz {
  id          String    @id @default(uuid())
  liveClassId String
  courseId    String
  questionIds String[]
  secondsEach Int       @default(60)
  startedAt   DateTime  @default(now())
  endsAt      DateTime
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([liveClassId])
}

/// Breakout group: its own video room for a few minutes
model ClassGroup {
  id          String    @id @default(uuid())
  liveClassId String
  name        String
  roomUrl     String
  memberIds   String[]
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([liveClassId])
}

/// A kind of crash in the portal or the API, grouped by cause. No names or emails are stored with it.
model ErrorEvent {
  id          String     @id @default(uuid())
  fingerprint String     @unique
  /// PORTAL | API
  source      String
  message     String
  where       String
  stack       String?
  count       Int        @default(1)
  /// Who hit it (user ids only, up to 50), to look them up
  userIds     String[]
  /// e.g. { "Chrome on Android": 12 }
  browsers    Json?
  /// OPEN | FIXED | IGNORED. A FIXED kind that happens again opens again.
  status      String     @default("OPEN")
  firstSeen   DateTime   @default(now())
  lastSeen    DateTime   @default(now())
  notifiedAt  DateTime?
  hits        ErrorHit[]

  @@index([status, lastSeen])
}

/// Each time an error happens; kept 30 days for the "last 24 hours" numbers
model ErrorHit {
  id      String     @id @default(uuid())
  errorId String
  userId  String?
  at      DateTime   @default(now())
  error   ErrorEvent @relation(fields: [errorId], references: [id], onDelete: Cascade)

  @@index([at])
}

/// One row per person per day they used the portal: daily, weekly and monthly active people over time
model ActiveDay {
  userId String
  day    DateTime    @db.Date
  device String?
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

/// Who has pressed play on a class recording, and how often (counted for students only)
model RecordingView {
  liveClassId String
  userId      String
  views       Int         @default(1)
  firstAt     DateTime    @default(now())
  lastAt      DateTime    @default(now())
  liveClass   LiveClass   @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([liveClassId, userId])
  @@index([userId])
}

enum WithdrawalStatus {
  /// Over the limit, or paid by hand: waiting for an admin
  AWAITING_APPROVAL
  /// Sent to Tranzak, waiting for the operator
  SENDING
  PAID
  /// The operator refused it; the money went back to the balance
  FAILED
  /// An admin refused it; the money went back to the balance
  REJECTED
}

/// Money an earner takes out of their balance, sent to their mobile money through Tranzak or paid by hand
model Withdrawal {
  id              String           @id @default(uuid())
  userId          String
  amount          Int
  /// What the operator charged, once known
  fee             Int?
  currency        String
  status          WithdrawalStatus
  /// tranzak or manual
  method          String
  /// e.g. "MTN Mobile Money ·· 182", as it was at the time
  paidTo          String
  payeeNumber     String
  payeeName       String?
  /// Our reference, sent to Tranzak so a retry can never pay twice
  reference       String           @unique
  transferId      String?
  /// The wallet debit that took the money out of the balance; removed if the withdrawal fails or is refused
  debitTxId       String?
  /// Who approved it, as [{ adminId, name, at }]
  approvals       Json             @default("[]")
  approvalsNeeded Int              @default(0)
  /// Why it waits for approval: over the limit, paid by hand, unusual
  flags           String[]
  failureReason   String?
  rejectedById    String?
  requestedAt     DateTime         @default(now())
  sentAt          DateTime?
  completedAt     DateTime?
  user            UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, requestedAt])
}
