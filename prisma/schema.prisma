generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                   String                   @id @default(uuid())
  wpUserId             Int                      @unique
  email                String                   @unique
  role                 UserRole                 @default(STUDENT)
  approvalStatus       ApprovalStatus           @default(APPROVED)
  countryId            String?
  currentLevelId       String?
  onboardingCompleted  Boolean                  @default(false)
  avatarUrl            String?
  name                 String?
  phone                String?
  firstName            String?
  lastName             String?
  bio                  String?
  linkedinUrl          String?
  websiteUrl           String?
  timezone             String?
  videoIntroUrl        String?
  /// bcrypt hash; copied from WordPress the first time someone signs in after the switch, then the portal checks it itself
  passwordHash         String?
  passwordUpdatedAt    DateTime?
  /// Settings → Delete my account: asked at, and when it happens (7 days later); deletedAt once done
  deletionRequestedAt  DateTime?
  deletionDueAt        DateTime?
  deletedAt            DateTime?
  googleId             String?                  @unique
  lastActiveDate       DateTime?
  /// Last time they used the portal (any signed-in request, at most every few minutes) and on what
  lastSeenAt           DateTime?
  /// phone, tablet or computer
  lastDevice           String?
  /// How the account began: portal, website, referral, google, import (school seats are on OrgSeat)
  signupSource         String?
  activeDays           ActiveDay[]
  recordingViews       RecordingView[]
  withdrawals          Withdrawal[]
  /// When the account was created (backfilled for older accounts from their first activity)
  createdAt            DateTime                 @default(now())
  microsoftId          String?                  @unique
  streak               Int                      @default(0)
  xpTotal              Int                      @default(0)
  /// Whether classmates see this student's name on leaderboards (they always see their own)
  leaderboardVisible   Boolean                  @default(true)
  /// Per notification type: { [type]: { inApp: boolean, email: boolean } }
  notificationPrefs    Json?
  /// { language, textSize, dataSaver, autoplay, downloadOnWifi }
  displayPrefs         Json?
  agreementAcceptedAt  DateTime?
  /// Terms and Conditions + Privacy Policy, agreed at sign-up: when, and which version
  termsAcceptedAt      DateTime?
  termsVersion         String?
  agreementVersion     String?
  agreementIp          String?
  certificates         Certificate[]
  teacherCohorts       Cohort[]                 @relation("TeacherCohorts")
  cohorts              CohortRoster[]
  discussionPosts      CourseDiscussionPost[]
  courseEnrollments    CourseEnrollment[]
  /// For ORG_ADMIN: the organisation they run
  organisationId       String?
  organisation         Organisation?            @relation("OrgAdmins", fields: [organisationId], references: [id])
  paymentAttempts      PaymentAttempt[]
  staffPosts           StaffPost[]              @relation("StaffPosts")
  studyBlocks          StudyBlock[]             @relation("StudentStudyBlocks")
  threadReads          ThreadRead[]
  threadMemberships    ThreadMember[]
  messageReactions     MessageReaction[]
  messageStars         MessageStar[]
  callsStarted         Call[]                   @relation("CallsStarted")
  callParticipations   CallParticipant[]
  pushSubscriptions    PushSubscription[]
  wpPulls              WpPull[]
  coursePurchases      CoursePurchase[]
  discussionUpvotes    DiscussionUpvote[]
  flashcardReviews     FlashcardReview[]
  lessonBookmarks      LessonBookmark[]
  lessonNotes          LessonNote[]
  lessonProgress       LessonProgress[]
  liveAttendance       LiveAttendance[]         @relation("StudentAttendance")
  mentorBookings       MentorBooking[]          @relation("StudentBookings")
  mentorSlots          MentorSlot[]             @relation("TeacherSlots")
  sentMessages         Message[]                @relation("SentMessages")
  messageThreadsAsA    MessageThread[]          @relation("ThreadParticipantA")
  messageThreadsAsB    MessageThread[]          @relation("ThreadParticipantB")
  purchases            PackagePurchase[]
  payoutAccount        PayoutAccount?
  peerReviewsGiven     PeerReview[]             @relation("PeerReviewGiver")
  platformCourses      PlatformCourse[]         @relation("TeacherCourses")
  progressAlerts       ProgressAlert[]
  quizAttempts         QuizAttempt[]
  rubricScores         RubricScore[]            @relation("GraderRubricScores")
  submissions          Submission[]
  successStories       SuccessStorySubmission[]
  supportTickets       SupportTicket[]
  teacherApplication   TeacherApplication?
  studentReviews       TeacherReview[]          @relation("StudentTeacherReviews")
  teacherReviews       TeacherReview[]          @relation("TeacherReviews")
  userBadges           UserBadge[]
  country              Country?                 @relation(fields: [countryId], references: [id])
  wallet               Wallet?
  xpEvents             XPEvent[]
  programmeInterests   Programme[]              @relation("StudentProgrammeInterests")
  teachingProgrammes   Programme[]              @relation("TeacherProgrammes")
  teachingSubjects     Subject[]                @relation("TeacherSubjects")
  onboardingVideoViews OnboardingVideoView[]
  practiceAttempts     PracticeAttempt[]
  notifications        Notification[]
  broadcastsSent       Broadcast[]
  /// Shareable code, generated the first time the student opens the referrals page
  referralCode         String?                  @unique
  referredById         String?
  referredBy           UserProfile?             @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            UserProfile[]            @relation("Referrals")
  testSessions         TestSession[]
  questionProgress     QuestionProgress[]
}

/// In-app inbox item. `type` matches the portal's icons: live | assignment | grade | certificate | message | system.
model Notification {
  id          String      @id @default(uuid())
  userId      String
  type        String
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime    @default(now())
  broadcastId String?
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast   Broadcast?  @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// Admin announcement sent to an audience; fans out into Notification rows and/or emails.
model Broadcast {
  id             String         @id @default(uuid())
  title          String
  body           String
  audience       String
  channel        String
  countryId      String?
  sentById       String
  recipientCount Int            @default(0)
  sentAt         DateTime       @default(now())
  sentBy         UserProfile    @relation(fields: [sentById], references: [id])
  notifications  Notification[]
}

/// Mandatory orientation video for teachers (one row per audience; only TEACHER today).
/// Bumping `version` makes everyone watch again.
model OnboardingVideo {
  id          String                @id @default(uuid())
  audience    String                @unique @default("TEACHER")
  title       String
  videoUrl    String
  captionsUrl String?
  durationSec Int?
  version     Int                   @default(1)
  isActive    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  views       OnboardingVideoView[]
}

/// Server-side watch progress — completion is decided here, never by the client alone.
model OnboardingVideoView {
  id            String          @id @default(uuid())
  userId        String
  videoId       String
  version       Int
  maxWatchedSec Float           @default(0)
  durationSec   Float?
  lastReportAt  DateTime        @default(now())
  completedAt   DateTime?
  user          UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         OnboardingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId, version])
}

model SupportTicket {
  id        String      @id @default(uuid())
  studentId String
  category  String
  subject   String
  message   String
  status    String      @default("OPEN")
  adminNote String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  student   UserProfile @relation(fields: [studentId], references: [id])
}

model Country {
  id                   String           @id @default(uuid())
  code                 String           @unique
  name                 String
  currency             String
  repCommissionPercent Float?
  perStudentBonus      Int?
  educationSystemId    String?
  educationSystem      EducationSystem? @relation(fields: [educationSystemId], references: [id])
  reps                 UserProfile[]
  programmes           Programme[]      @relation("ProgrammeCountries")
}

model EducationSystem {
  id         String           @id @default(uuid())
  name       String           @unique
  countries  Country[]
  levels     EducationLevel[]
  programmes Programme[]
}

model EducationLevel {
  id                String           @id @default(uuid())
  name              String
  tier              EducationTier
  sortOrder         Int
  educationSystemId String
  educationSystem   EducationSystem  @relation(fields: [educationSystemId], references: [id])
  platformCourses   PlatformCourse[]
  programmes        Programme[]      @relation("ProgrammeLevels")
  wpCategoryMaps    WpCategoryMap[]

  @@unique([educationSystemId, sortOrder])
}

model Programme {
  id                String               @id @default(uuid())
  name              String               @unique
  shortName         String?
  description       String?
  type              ProgrammeType
  scope             ProgrammeScope       @default(GLOBAL)
  educationSystemId String?
  cpdProfession     String?
  cpdBody           String?
  cpdHoursPerCycle  Int?
  logoUrl           String?
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  platformCourses   PlatformCourse[]
  educationSystem   EducationSystem?     @relation(fields: [educationSystemId], references: [id])
  countries         Country[]            @relation("ProgrammeCountries")
  levels            EducationLevel[]     @relation("ProgrammeLevels")
  subjects          Subject[]            @relation("ProgrammeSubjects")
  studentInterests  UserProfile[]        @relation("StudentProgrammeInterests")
  teacherProfiles   UserProfile[]        @relation("TeacherProgrammes")
  priceDefaults     CoursePriceDefault[]
  wpCategoryMaps    WpCategoryMap[]
}

model Subject {
  id              String           @id @default(uuid())
  name            String
  category        SubjectCategory
  isPractical     Boolean          @default(false)
  platformCourses PlatformCourse[]
  programmes      Programme[]      @relation("ProgrammeSubjects")
  teacherProfiles UserProfile[]    @relation("TeacherSubjects")
  wpCategoryMaps  WpCategoryMap[]

  @@unique([name, category])
}

model ExchangeRate {
  id        String   @id @default(uuid())
  currency  String   @unique
  toUsdRate Float
  updatedAt DateTime @updatedAt
}

model Package {
  id                         String            @id @default(uuid())
  /// Shown as "Best value" on the packages page (one at a time). None chosen: the page picks one itself
  bestValue                  Boolean           @default(false)
  name                       String
  description                String?
  priceAmount                Int
  currency                   String
  /// Extras offered at checkout: { live?: { cohortId, price }, mentorship?: { perMonth, price } } (prices in minor units)
  addOns                     Json?
  courseIds                  String[]
  categoryTags               String[]
  validityDays               Int?
  isPublished                Boolean           @default(false)
  cohortId                   String?
  /// What mentorship the package includes, e.g. "Monthly 1-to-1 session"; shown only when set
  mentorship                 String?
  /// 1-to-1 mentorship sessions a buyer can book each month; null = no limit
  mentorshipSessionsPerMonth Int?
  /// Questions and answers shown on the package page: [{ q, a }]; empty = the standard questions
  faq                        Json?
  createdAt                  DateTime          @default(now())
  purchases                  PackagePurchase[]
  cohort                     Cohort?           @relation("PackageCohort", fields: [cohortId], references: [id])
}

model PackagePurchase {
  id           String              @id @default(uuid())
  studentId    String
  packageId    String
  couponId     String?
  purchasedAt  DateTime            @default(now())
  expiresAt    DateTime?
  amountPaid   Int?
  currency     String?
  /// Extras bought with it: [{ kind: live|mentorship, price, cohortId?, perMonth? }]
  addOns       Json?
  gateway      String?
  gatewayRef   String?
  invoiceNo    String?             @unique
  refundedAt   DateTime?
  package      Package             @relation(fields: [packageId], references: [id])
  student      UserProfile         @relation(fields: [studentId], references: [id])
  transactions WalletTransaction[]
}

model CoursePurchase {
  id           String              @id @default(uuid())
  studentId    String
  courseId     String
  amountPaid   Int
  currency     String
  /// Extras bought with it: [{ kind: live|mentorship, price, cohortId?, perMonth? }]
  addOns       Json?
  purchasedAt  DateTime            @default(now())
  expiresAt    DateTime?
  gateway      String?
  gatewayRef   String?
  invoiceNo    String?             @unique
  refundedAt   DateTime?
  course       PlatformCourse      @relation(fields: [courseId], references: [id])
  student      UserProfile         @relation(fields: [studentId], references: [id])
  transactions WalletTransaction[]

  @@unique([studentId, courseId])
}

model TeacherApplication {
  id                   String      @id @default(uuid())
  userId               String      @unique
  subjectAreas         String[]
  yearsExperience      Int?
  bio                  String
  documentUrl          String?
  submittedAt          DateTime    @default(now())
  firstName            String?
  lastName             String?
  linkedinUrl          String?
  phone                String?
  qualification        String?
  rejectionReason      String?
  teachingModality     String?
  websiteUrl           String?
  teachingProgrammeIds String[]
  teachingSubjectIds   String[]
  user                 UserProfile @relation(fields: [userId], references: [id])
}

model Cohort {
  id             String          @id @default(uuid())
  name           String
  teacherId      String
  examDate       DateTime?
  sittingLabel   String?
  startDate      DateTime?
  assignments    Assignment[]
  teacher        UserProfile     @relation("TeacherCohorts", fields: [teacherId], references: [id])
  students       CohortRoster[]
  liveClasses    LiveClass[]
  progressAlerts ProgressAlert[]
  packages       Package[]       @relation("PackageCohort")
  chat           MessageThread?
}

model CohortRoster {
  id        String      @id @default(uuid())
  studentId String
  cohortId  String
  /// How the student joined: PACKAGE (bought a linked package), ORG (school seat), ADMIN or TEACHER (added by hand)
  source    String      @default("ADMIN")
  addedAt   DateTime    @default(now())
  cohort    Cohort      @relation(fields: [cohortId], references: [id])
  student   UserProfile @relation(fields: [studentId], references: [id])

  @@unique([studentId, cohortId])
}

model LiveClass {
  id                 String           @id @default(uuid())
  cohortId           String
  title              String
  dailyRoomUrl       String
  scheduledAt        DateTime
  status             ClassStatus      @default(SCHEDULED)
  description        String?
  durationMins       Int              @default(90)
  recordingUrl       String?
  /// Daily cloud recording id; a short-lived watch link is fetched from Daily when someone opens it
  recordingId        String?
  whiteboardSnapshot String?
  /// Pay for teaching it: null until settled, then PAID or MISSED (the teacher never joined)
  teacherPay         String?
  /// Minutes the teacher was paid for, and the amount (minor units)
  teacherPaidMins    Int?
  teacherPaidAmount  Int?
  attendance         LiveAttendance[]
  cohort             Cohort           @relation(fields: [cohortId], references: [id])
  polls              ClassPoll[]
  questions          ClassQuestion[]
  quizzes            ClassQuiz[]
  groups             ClassGroup[]
  views              RecordingView[]
}

model LiveAttendance {
  id          String      @id @default(uuid())
  liveClassId String
  studentId   String
  joinedAt    DateTime    @default(now())
  leftAt      DateTime?
  liveClass   LiveClass   @relation(fields: [liveClassId], references: [id])
  student     UserProfile @relation("StudentAttendance", fields: [studentId], references: [id])

  @@unique([liveClassId, studentId])
}

model Assignment {
  id              String            @id @default(uuid())
  cohortId        String
  title           String
  description     String
  maxPoints       Int
  dueDate         DateTime
  isPeerReviewed  Boolean           @default(false)
  peerReviewCount Int               @default(3)
  cohort          Cohort            @relation(fields: [cohortId], references: [id])
  rubric          AssignmentRubric?
  submissions     Submission[]
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  grade        Int?
  feedback     String?
  status       SubmissionStatus @default(PENDING_REVIEW)
  submittedAt  DateTime         @default(now())
  aiFeedback   String?
  /// The student's note to the teacher when handing in
  note         String?
  peerReviews  PeerReview[]
  rubricScores RubricScore[]
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  student      UserProfile      @relation(fields: [studentId], references: [id])

  @@unique([studentId, assignmentId])
}

model AssignmentRubric {
  id           String            @id @default(uuid())
  assignmentId String            @unique
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria     RubricCriterion[]
}

model RubricCriterion {
  id          String           @id @default(uuid())
  rubricId    String
  title       String
  /// Marks this criterion is worth
  weight      Float
  /// Levels, lowest first: [{ points, label }]
  descriptors Json
  sortOrder   Int              @default(0)
  rubric      AssignmentRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores      RubricScore[]
}

model RubricScore {
  id           String          @id @default(uuid())
  submissionId String
  criterionId  String
  graderId     String
  score        Int
  comment      String?
  criterion    RubricCriterion @relation(fields: [criterionId], references: [id])
  grader       UserProfile     @relation("GraderRubricScores", fields: [graderId], references: [id])
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId, graderId])
}

model PeerReview {
  id           String           @id @default(uuid())
  assignmentId String
  reviewerId   String
  submissionId String
  grade        Int?
  feedback     String?
  status       PeerReviewStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  reviewer     UserProfile      @relation("PeerReviewGiver", fields: [reviewerId], references: [id])
  submission   Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, submissionId])
}

model QuestionBank {
  id             String              @id @default(uuid())
  courseId       String
  questionText   String
  type           QuestionType
  options        Json?
  correctAnswer  String
  explanation    String?
  lessonId       String?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  difficulty     QuestionDifficulty  @default(MEDIUM)
  imageUrl       String?
  points         Int                 @default(1)
  tags           String[]            @default([])
  /// Practice questions on video lessons: where in the video this is explained (seconds)
  videoAtSec     Int?
  /// Tutor question this was imported from; a re-import updates it in place
  wpQuestionId   Int?
  /// DRAFT and IN_REVIEW never reach students; everything older stays LIVE
  status         QuestionStatus      @default(LIVE)
  /// Written for the Test Centre: not part of any lesson quiz or course quiz
  bankOnly       Boolean             @default(false)
  /// What a bank question covers, without adding it to that module or lesson's quiz
  moduleId       String?
  sourceLessonId String?
  /// Structured questions: [{ label, text, marks, markScheme }]
  parts          Json?
  createdById    String?
  reviewNote     String?
  /// Written by AI, not yet checked by a teacher
  aiGenerated    Boolean             @default(false)
  /// Difficulty on the ability scale for adaptive tests; null until calibrated from answers (the label is used until then)
  irtB           Float?
  /// How many answers the calibration was based on
  irtN           Int                 @default(0)
  /// AI suggestion waiting for the teacher: { explanation, modelAnswer?, markSchemes?, answerLooksWrong, note, at }. Never shown to students.
  aiDraft        Json?
  attemptAnswers QuizAttemptAnswer[]
  testAnswers    TestAnswer[]
  progress       QuestionProgress[]

  @@index([courseId, status])
}

/// A paper set up once and taken by many: a teacher's mock exam, or a real past paper
model MockExam {
  id              String        @id @default(uuid())
  kind            ExamKind      @default(MOCK)
  title           String
  description     String?
  programmeId     String?
  /// Who can take it: anyone with access to one of these courses, or who bought one of these packages
  courseIds       String[]
  packageIds      String[]
  status          ExamStatus    @default(DRAFT)
  timeLimitSecs   Int
  passMark        Int           @default(50)
  /// 0 means no limit
  attemptsAllowed Int           @default(0)
  /// Whether students see the right answers after submitting
  showAnswers     Boolean       @default(true)
  /// true: each student gets a different mix following `sections`; false: everyone gets `questionIds` in order
  randomised      Boolean       @default(true)
  /// [{ title, courseIds, moduleIds, tags, count, easy, medium, hard }]
  sections        Json?
  questionIds     String[]
  /// Past papers
  examBody        String?
  year            Int?
  session         String?
  paperNumber     String?
  /// CAT: stop between these many questions; the passing standard is on the ability scale (logits)
  catMin          Int?
  catMax          Int?
  catStandard     Float?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  attempts        TestSession[]

  @@index([status, kind])
}

/// One test a student took in the Test Centre. Separate from QuizAttempt, so it never touches course grades or certificates.
model TestSession {
  id            String       @id @default(uuid())
  studentId     String
  mode          TestMode
  status        TestStatus   @default(IN_PROGRESS)
  title         String
  filters       Json?
  questionIds   String[]
  timeLimitSecs Int?
  /// Set when this is an attempt at a teacher's mock exam or a past paper
  mockExamId    String?
  mockExam      MockExam?    @relation(fields: [mockExamId], references: [id], onDelete: SetNull)
  startedAt     DateTime     @default(now())
  expiresAt     DateTime?
  submittedAt   DateTime?
  score         Float?
  maxScore      Int          @default(0)
  /// Adaptive test state: ability estimate, served questions, the item pool and the final decision
  cat           Json?
  student       UserProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       TestAnswer[]

  @@index([studentId, startedAt])
}

model TestAnswer {
  id         String       @id @default(uuid())
  sessionId  String
  questionId String
  answer     Json?
  /// Null until written answers are marked
  isCorrect  Boolean?
  score      Float?
  flagged    Boolean      @default(false)
  timeSecs   Int          @default(0)
  /// Who gave the mark on a written answer: SELF or AI
  markedBy   String?
  aiFeedback String?
  session    TestSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
}

/// Where a student stands on a question: drives the unused, wrong, learning, mastered and flagged pools
model QuestionProgress {
  studentId     String
  questionId    String
  seen          Int          @default(0)
  correctStreak Int          @default(0)
  lastCorrect   Boolean?
  flagged       Boolean      @default(false)
  updatedAt     DateTime     @updatedAt
  student       UserProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question      QuestionBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([studentId, questionId])
}

/// Practice on video/text lessons — kept apart from QuizAttempt so it never affects quiz scores or certificates
model PracticeAttempt {
  id        String      @id @default(uuid())
  studentId String
  lessonId  String
  score     Int
  total     Int
  createdAt DateTime    @default(now())
  student   UserProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([studentId, lessonId])
}

model QuizAttempt {
  id            String              @id @default(uuid())
  studentId     String
  courseId      String
  autoScore     Int
  manualScore   Int                 @default(0)
  finalScore    Int                 @default(0)
  isFullyGraded Boolean             @default(false)
  answersJson   Json
  submittedAt   DateTime            @default(now())
  lessonId      String?
  maxScore      Int                 @default(0)
  passed        Boolean             @default(false)
  timeTakenSecs Int?
  /// Teacher's feedback when grading written answers
  feedback      String?
  gradedAt      DateTime?
  student       UserProfile         @relation(fields: [studentId], references: [id])
  answers       QuizAttemptAnswer[]
}

/// Per-question answer record for detailed analytics
model QuizAttemptAnswer {
  id         String       @id @default(uuid())
  attemptId  String
  questionId String
  answer     Json
  isCorrect  Boolean?
  score      Float        @default(0)
  aiFeedback String?
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   QuestionBank @relation(fields: [questionId], references: [id])
}

model CourseAssignment {
  id                    String       @id @default(uuid())
  courseId              String       @unique
  teacherId             String?
  teacherCommissionPct  Float?
  reviewerId            String?
  reviewerCommissionPct Float?
  reviewStatus          ReviewStatus @default(PENDING)
  reviewedAt            DateTime?
  reviewNotes           String?
  /// When the teacher last sent the course for review
  submittedAt           DateTime?
  /// The reviewer's checklist: { accuracy: "good" | "fix", ... }
  reviewChecklist       Json?
  updatedAt             DateTime     @updatedAt
  programmeId           String?
  subjectId             String?
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Int                 @default(0)
  currency     String
  updatedAt    DateTime            @updatedAt
  user         UserProfile         @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id                String           @id @default(uuid())
  walletId          String
  type              WalletTxType
  source            WalletTxSource
  amount            Int
  currency          String
  packagePurchaseId String?
  courseId          String?
  description       String?
  /// The admin who added a manual credit
  createdById       String?
  createdAt         DateTime         @default(now())
  coursePurchaseId  String?
  coursePurchase    CoursePurchase?  @relation(fields: [coursePurchaseId], references: [id])
  packagePurchase   PackagePurchase? @relation(fields: [packagePurchaseId], references: [id])
  wallet            Wallet           @relation(fields: [walletId], references: [id])
}

model Certificate {
  id         String         @id @default(uuid())
  studentId  String
  courseId   String
  issuedAt   DateTime       @default(now())
  verifyCode String         @unique
  pdfUrl     String
  course     PlatformCourse @relation(fields: [courseId], references: [id])
  student    UserProfile    @relation(fields: [studentId], references: [id])
}

model MentorSlot {
  id           String         @id @default(uuid())
  teacherId    String
  startsAt     DateTime
  endsAt       DateTime
  isBooked     Boolean        @default(false)
  durationMins Int            @default(30)
  booking      MentorBooking?
  teacher      UserProfile    @relation("TeacherSlots", fields: [teacherId], references: [id])
}

model MentorBooking {
  id                 String        @id @default(uuid())
  slotId             String        @unique
  studentId          String
  notes              String?
  bookedAt           DateTime      @default(now())
  cancelReason       String?
  cancelledAt        DateTime?
  meetingUrl         String?
  /// The shared whiteboard from the session, saved as it was drawn
  whiteboardSnapshot String?
  status             String        @default("CONFIRMED")
  slot               MentorSlot    @relation(fields: [slotId], references: [id])
  student            UserProfile   @relation("StudentBookings", fields: [studentId], references: [id])
  review             MentorReview?
}

model MentorReview {
  id        String        @id @default(uuid())
  bookingId String        @unique
  studentId String
  teacherId String
  rating    Int
  comment   String?
  createdAt DateTime      @default(now())
  booking   MentorBooking @relation(fields: [bookingId], references: [id])
}

model TeacherReview {
  id        String      @id @default(uuid())
  teacherId String
  studentId String
  rating    Int
  comment   String?
  createdAt DateTime    @default(now())
  student   UserProfile @relation("StudentTeacherReviews", fields: [studentId], references: [id])
  teacher   UserProfile @relation("TeacherReviews", fields: [teacherId], references: [id])

  @@unique([teacherId, studentId])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  percentOff     Int?
  amountOff      Int?
  packageId      String?
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

/// A school or company that buys seats; its admins (role ORG_ADMIN) manage them in the school portal
model Organisation {
  id           String          @id @default(uuid())
  name         String
  countryId    String?
  contactEmail String
  /// Code in the school's join link; anyone signing up with it takes a free seat
  joinCode     String          @unique
  joinEnabled  Boolean         @default(true)
  /// When set, only emails ending in this domain can use the join link, e.g. "achimota.edu.gh"
  emailDomain  String?
  createdAt    DateTime        @default(now())
  enrollments  OrgEnrollment[]
  admins       UserProfile[]   @relation("OrgAdmins")
}

model OrgEnrollment {
  id               String        @id @default(uuid())
  organisationId   String?
  organizationName String
  contactEmail     String
  packageId        String
  /// Seats bought; invites and link joins can't go past it
  seatsPurchased   Int
  /// Agreed price per seat (minor units), recorded for reference; seats are invoiced outside the portal
  pricePerSeat     Int?
  currency         String?
  purchasedAt      DateTime      @default(now())
  organisation     Organisation? @relation(fields: [organisationId], references: [id])
  seats            OrgSeat[]
}

model OrgSeat {
  id              String        @id @default(uuid())
  orgEnrollmentId String
  /// Null for a seat taken through the join link
  inviteEmail     String?
  studentId       String?
  claimedAt       DateTime?
  /// EMAIL (invited) or LINK (joined with the school's link)
  joinedVia       String        @default("EMAIL")
  invitedAt       DateTime      @default(now())
  remindedAt      DateTime?
  orgEnrollment   OrgEnrollment @relation(fields: [orgEnrollmentId], references: [id])
}

/// Every checkout a student starts, so failed, abandoned and paid-but-not-delivered payments can be seen and fixed
model PaymentAttempt {
  id                String      @id @default(uuid())
  studentId         String
  /// package or course
  kind              String
  packageId         String?
  courseId          String?
  title             String
  amount            Int
  currency          String
  /// Extras chosen at checkout, applied when it's paid
  addOns            Json?
  /// Its own invoice number, for an add-on bought after the course or package
  invoiceNo         String?
  gateway           String
  /// The gateway's reference for this checkout (Paystack reference, Stripe session, Tranzak request)
  sessionId         String?     @unique
  /// Tranzak's merchant reference, when used
  tranzakSessionId  String?
  couponId          String?
  /// PENDING, PAID, FAILED, ABANDONED or REFUNDED
  status            String      @default("PENDING")
  failureReason     String?
  paidAt            DateTime?
  checkedAt         DateTime?
  packagePurchaseId String?
  coursePurchaseId  String?
  createdAt         DateTime    @default(now())
  student           UserProfile @relation(fields: [studentId], references: [id])

  @@index([status, createdAt])
  @@index([studentId])
}

/// Money sent back to a student, recorded by an admin after refunding through the gateway
model Refund {
  id          String   @id @default(uuid())
  /// package or course
  kind        String
  purchaseId  String
  studentId   String
  amount      Int
  currency    String
  reason      String
  /// Their access was ended with the refund
  endedAccess Boolean  @default(false)
  /// Commission taken back from wallets that hadn't been paid out (minor units, summed)
  clawedBack  Int      @default(0)
  byId        String
  createdAt   DateTime @default(now())

  @@index([purchaseId])
}

/// The teachers' staff room: posts and replies only teachers, reviewers and admins see
model StaffPost {
  id          String        @id @default(uuid())
  /// announcements, tips, exams, portal
  room        String
  authorId    String
  parentId    String?
  body        String
  isPinned    Boolean       @default(false)
  upvoteCount Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      UserProfile   @relation("StaffPosts", fields: [authorId], references: [id])
  parent      StaffPost?    @relation("StaffReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     StaffPost[]   @relation("StaffReplies")
  upvotes     StaffUpvote[]

  @@index([room, createdAt])
}

model StaffUpvote {
  id     String    @id @default(uuid())
  postId String
  userId String
  post   StaffPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PayoutStatement {
  id            String              @id @default(uuid())
  recipientId   String
  recipientType PayoutRecipientType
  periodStart   DateTime
  periodEnd     DateTime
  amount        Int
  currency      String
  status        PayoutStatus        @default(PENDING)
  generatedAt   DateTime            @default(now())
  paidAt        DateTime?
  /// The mobile money or bank transaction reference, so the person can trace the payment
  reference     String?
  /// e.g. "MTN Mobile Money ·· 1182" — where it was sent, as it was at the time
  paidTo        String?
  note          String?
  paidById      String?
}

model CourseDiscussionPost {
  id          String                 @id @default(uuid())
  courseId    String
  authorId    String
  parentId    String?
  body        String
  createdAt   DateTime               @default(now())
  lessonId    String?
  isPinned    Boolean                @default(false)
  updatedAt   DateTime               @updatedAt
  upvoteCount Int                    @default(0)
  author      UserProfile            @relation(fields: [authorId], references: [id])
  parent      CourseDiscussionPost?  @relation("DiscussionReplies", fields: [parentId], references: [id])
  replies     CourseDiscussionPost[] @relation("DiscussionReplies")
  upvotes     DiscussionUpvote[]
}

model DiscussionUpvote {
  id     String               @id @default(uuid())
  postId String
  userId String
  post   CourseDiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   UserProfile          @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model SuccessStorySubmission {
  id               String       @id @default(uuid())
  studentId        String
  story            String
  consentToPublish Boolean      @default(false)
  status           ReviewStatus @default(PENDING)
  submittedAt      DateTime     @default(now())
  student          UserProfile  @relation(fields: [studentId], references: [id])
}

model PlatformCourse {
  id                    String             @id @default(uuid())
  title                 String
  description           String?
  coverUrl              String?
  teacherId             String
  programmeId           String?
  subjectId             String?
  levelId               String?
  status                CourseStatus       @default(DRAFT)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  source                CourseSource       @default(NATIVE)
  wpCourseId            Int?               @unique
  wpCourseUrl           String?
  isSoldIndividually    Boolean            @default(false)
  /// A teacher's proposed single-course price (minor units), waiting for an admin decision
  proposedPriceAmount   Int?
  proposedPriceCurrency String?
  priceProposedAt       DateTime?
  priceAmount           Int?
  priceCurrency         String?
  /// Extras offered at checkout: { live?: { cohortId, price }, mentorship?: { perMonth, price } } (prices in minor units)
  addOns                Json?
  shortDescription      String?
  /// How long a single-course purchase gives access, in months; null = no time limit
  accessMonths          Int?               @default(12)
  /// Teaching language, e.g. "English" or "French"; shown to students only when set
  language              String?
  /// What students will be able to do after the course; shown on the course page when set
  outcomes              String[]           @default([])
  /// Kept for enrolled students but not listed in the catalogue, search or packages pickers
  catalogueHidden       Boolean            @default(false)
  /// No real teacher yet: teacherId holds the CareerPath owner until an admin assigns one
  teacherPending        Boolean            @default(false)
  /// The course as last pulled from WordPress, so the next pull can show what changed there
  wpTitle               String?
  wpDescription         String?
  wpStatus              String?
  wpModifiedAt          DateTime?
  wpCategoryIds         Int[]              @default([])
  wpAuthorEmail         String?
  wpPulledAt            DateTime?
  /// Topics, lessons and quizzes were copied from Tutor LMS, so the course plays in the portal's player
  contentImportedAt     DateTime?
  certificates          Certificate[]
  enrollments           CourseEnrollment[]
  modules               CourseModule[]
  coursePurchases       CoursePurchase[]
  flashcardDecks        FlashcardDeck[]
  level                 EducationLevel?    @relation(fields: [levelId], references: [id])
  programme             Programme?         @relation(fields: [programmeId], references: [id])
  subject               Subject?           @relation(fields: [subjectId], references: [id])
  teacher               UserProfile        @relation("TeacherCourses", fields: [teacherId], references: [id])
}

model CourseModule {
  id        String         @id @default(uuid())
  courseId  String
  title     String
  sortOrder Int
  /// Tutor topic this module was imported from; a re-import updates it in place
  wpTopicId Int?
  course    PlatformCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id               String             @id @default(uuid())
  moduleId         String
  title            String
  type             LessonType
  videoUrl         String?
  /// Optional smaller copy (e.g. 360p) for students on Data saver
  videoUrlLow      String?
  content          String?
  sortOrder        Int
  durationSecs     Int?
  isFree           Boolean            @default(false)
  maxAttempts      Int                @default(0)
  passMark         Int?
  shuffleQuestions Boolean            @default(false)
  timeLimitSecs    Int?
  /// Video chapters: [{ startSec: number, title: string }], sorted by startSec
  chapters         Json?
  /// Plain-text transcript; lines may start with [mm:ss] to make them clickable timestamps
  transcript       String?
  /// Tutor lesson or quiz this was imported from; a re-import updates it in place
  wpItemId         Int?
  module           CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  attachments      LessonAttachment[]
  practiceAttempts PracticeAttempt[]
  bookmarks        LessonBookmark[]
  notes            LessonNote[]
  progress         LessonProgress[]
}

model LessonAttachment {
  id       String  @id @default(uuid())
  lessonId String
  name     String
  url      String
  fileType String?
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id           String      @id @default(uuid())
  studentId    String
  lessonId     String
  completed    Boolean     @default(false)
  /// Total seconds actually played (study time)
  watchedSecs  Int         @default(0)
  /// Last playback position, for "resume where you stopped"
  positionSecs Int         @default(0)
  updatedAt    DateTime    @updatedAt
  lesson       Lesson      @relation(fields: [lessonId], references: [id])
  student      UserProfile @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
}

model CourseEnrollment {
  id          String         @id @default(uuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime       @default(now())
  completedAt DateTime?
  course      PlatformCourse @relation(fields: [courseId], references: [id])
  student     UserProfile    @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

/// Webhook dedup — prevents double-fulfillment when a gateway retries a webhook.
model WebhookEvent {
  id          String   @id @default(uuid())
  gateway     String
  eventId     String
  processedAt DateTime @default(now())

  @@unique([gateway, eventId])
}

/// Temporary mapping created before a Tranzak payment request is sent.
/// Tranzak has no customData/metadata field, so we store the purchase context
/// here keyed by mchTransactionRef (= this record's id).
/// Cleaned up lazily after fulfillment.
model TranzakSession {
  id        String   @id @default(uuid())
  requestId String?  @unique
  studentId String
  packageId String?
  courseId  String?
  couponId  String?
  amount    Int
  currency  String
  createdAt DateTime @default(now())

  @@index([studentId])
}

/// Atomic invoice counter — one row per year/month, incremented inside a transaction.
model InvoiceCounter {
  id      String @id @default(uuid())
  year    Int
  month   Int
  lastVal Int    @default(0)

  @@unique([year, month])
}

/// Bank account details submitted by earners for payout processing.
model PayoutAccount {
  id             String      @id @default(uuid())
  userId         String      @unique
  bankName       String
  accountNumber  String
  bankCode       String?
  country        String
  isVerified     Boolean     @default(false)
  verifiedAt     DateTime?
  /// MTN or ORANGE: these are paid straight through Tranzak; anything else is paid by hand
  provider       String?
  /// The name the operator has on the number, when it could be checked
  holderName     String?
  /// match, mismatch or unchecked
  nameCheck      String?
  /// When the number last changed: money waits a while before it can go to a new number
  changedAt      DateTime?
  /// The withdrawal PIN, hashed
  pinHash        String?
  pinFailures    Int         @default(0)
  pinLockedUntil DateTime?
  pinSetAt       DateTime?
  /// Automatic payouts: weekly (Fridays), monthly (the 1st) or threshold (when the balance reaches autoThreshold)
  autoMode       String?
  autoThreshold  Int?
  /// The earner locked withdrawals (lost phone); unlocking needs a code
  lockedByUser   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           UserProfile @relation(fields: [userId], references: [id])
}

/// Immutable audit trail for compliance — records every admin action that touches money or roles.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())
}

/// A conversation thread between two users (student↔teacher or teacher↔teacher).
/// A one-to-one conversation (two participants) or a cohort's group chat (cohortId set, no participants)
model MessageThread {
  id              String         @id @default(uuid())
  participantAId  String?
  participantBId  String?
  cohortId        String?        @unique
  /// A group a teacher or admin made (members in ThreadMember). Cohort groups take their members from the cohort.
  isGroup         Boolean        @default(false)
  /// Group name, description and photo (a cohort group shows the cohort's name until someone renames it)
  name            String?
  description     String?
  photoUrl        String?
  createdById     String?
  /// Group settings, changed by group admins
  onlyAdminsSend  Boolean        @default(false)
  onlyAdminsEdit  Boolean        @default(true)
  membersCanAdd   Boolean        @default(false)
  pinnedMessageId String?
  lastMessageAt   DateTime       @default(now())
  createdAt       DateTime       @default(now())
  messages        Message[]
  reads           ThreadRead[]
  groupMembers    ThreadMember[]
  calls           Call[]
  participantA    UserProfile?   @relation("ThreadParticipantA", fields: [participantAId], references: [id])
  participantB    UserProfile?   @relation("ThreadParticipantB", fields: [participantBId], references: [id])
  cohort          Cohort?        @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([participantAId, participantBId])
}

/// People in a group. For groups a teacher or admin made, these rows are the members (leftAt set once they leave or are removed);
/// in cohort groups members come from the cohort, and a row only records a group admin or someone who muted the group.
model ThreadMember {
  id        String        @id @default(uuid())
  threadId  String
  userId    String
  role      String        @default("MEMBER") // MEMBER | ADMIN
  muted     Boolean       @default(false)
  addedById String?
  joinedAt  DateTime      @default(now())
  leftAt    DateTime?
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

/// How far each member has read a group chat (one-to-one threads use Message.readAt)
model ThreadRead {
  threadId   String
  userId     String
  lastReadAt DateTime      @default(now())
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model Message {
  id                 String            @id @default(uuid())
  threadId           String
  senderId           String
  body               String
  readAt             DateTime?
  createdAt          DateTime          @default(now())
  /// A file sent with the message: R2 key (served through a signed link), original name, type and size
  attachmentKey      String?
  attachmentName     String?
  attachmentType     String?
  attachmentSize     Int?
  /// Voice notes: length in seconds, and 40 bar heights (0-9) drawn as its waveform
  attachmentDuration Int?
  attachmentWave     String?
  /// TEXT, SYSTEM for notes like "Kofi added Ama" (sender = who did it), or CALL for a call's entry in the chat
  kind               String            @default("TEXT")
  callId             String?           @unique
  call               Call?             @relation(fields: [callId], references: [id])
  /// The message this one replies to (shown quoted)
  replyToId          String?
  /// People tagged with @, and whether @everyone was used
  mentions           String[]          @default([])
  mentionsAll        Boolean           @default(false)
  /// Edited: the latest text is in body; every earlier version is kept in MessageEdit
  editedAt           DateTime?
  /// "Delete for everyone" only hides it: the text, file and voice note stay stored, for the record
  deletedAt          DateTime?
  deletedById        String?
  sender             UserProfile       @relation("SentMessages", fields: [senderId], references: [id])
  replyTo            Message?          @relation("Replies", fields: [replyToId], references: [id])
  replies            Message[]         @relation("Replies")
  edits              MessageEdit[]
  reactions          MessageReaction[]
  stars              MessageStar[]
  thread             MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

/// A voice call in a chat: one-to-one (rings the other person) or a group call (started by a group admin; members join)
model Call {
  id           String            @id @default(uuid())
  threadId     String
  startedById  String
  kind         String // ONE | GROUP
  status       String            @default("RINGING") // RINGING | ACTIVE | ENDED | MISSED | DECLINED
  roomName     String
  roomUrl      String
  startedAt    DateTime          @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  thread       MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  startedBy    UserProfile       @relation("CallsStarted", fields: [startedById], references: [id])
  participants CallParticipant[]
  message      Message?

  @@index([threadId, status])
}

/// Someone in a call: when they joined and left (or declined)
model CallParticipant {
  id         String      @id @default(uuid())
  callId     String
  userId     String
  joinedAt   DateTime?
  leftAt     DateTime?
  declinedAt DateTime?
  call       Call        @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
}

/// A phone or computer that gets push notifications (calls, messages, every notice) when the portal is closed
model PushSubscription {
  id         String      @id @default(uuid())
  userId     String
  endpoint   String      @unique
  p256dh     String
  auth       String
  device     String?
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every earlier version of an edited message, kept for the record
model MessageEdit {
  id         String   @id @default(uuid())
  messageId  String
  body       String
  editedById String
  editedAt   DateTime @default(now())
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// One reaction per person per message
model MessageReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

/// Messages someone starred to find again (only they see it)
model MessageStar {
  messageId String
  userId    String
  createdAt DateTime    @default(now())
  message   Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model LessonNote {
  id        String      @id @default(uuid())
  studentId String
  lessonId  String
  timestamp Int?
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   UserProfile @relation(fields: [studentId], references: [id])
}

model LessonBookmark {
  id        String      @id @default(uuid())
  studentId String
  lessonId  String
  timestamp Int
  label     String?
  createdAt DateTime    @default(now())
  lesson    Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   UserProfile @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId, timestamp])
}

model XPEvent {
  id        String      @id @default(uuid())
  userId    String
  type      XPEventType
  points    Int
  meta      Json?
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [id])
}

model UserBadge {
  id       String      @id @default(uuid())
  userId   String
  badge    BadgeType
  earnedAt DateTime    @default(now())
  user     UserProfile @relation(fields: [userId], references: [id])

  @@unique([userId, badge])
}

model FlashcardDeck {
  id          String            @id @default(uuid())
  courseId    String
  lessonId    String?
  title       String
  aiGenerated Boolean           @default(false)
  createdAt   DateTime          @default(now())
  cards       Flashcard[]
  course      PlatformCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews     FlashcardReview[]
}

model Flashcard {
  id     String        @id @default(uuid())
  deckId String
  front  String
  back   String
  order  Int
  deck   FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
}

/// Spaced-repetition review record per student per card
model FlashcardReview {
  id           String        @id @default(uuid())
  deckId       String
  studentId    String
  cardId       String
  difficulty   Int
  nextReviewAt DateTime
  reviewedAt   DateTime      @default(now())
  deck         FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  student      UserProfile   @relation(fields: [studentId], references: [id])
}

model ProgressAlert {
  id             String      @id @default(uuid())
  cohortId       String
  teacherId      String
  type           AlertType
  thresholdDays  Int?
  thresholdScore Float?
  enabled        Boolean     @default(true)
  cohort         Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacher        UserProfile @relation(fields: [teacherId], references: [id])
}

/// Daily revenue snapshot for admin dashboard charts — avoids full table scans.
model RevenueSnapshot {
  id           String   @id @default(uuid())
  date         DateTime @unique
  totalRevenue Int      @default(0)
  newStudents  Int      @default(0)
  newPurchases Int      @default(0)
  createdAt    DateTime @default(now())
}

