{
  "name": "careerpathafrica",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @cpa/shared --filter @cpa/api --filter @cpa/portal run dev",
    "dev:api": "pnpm --filter @cpa/api run dev",
    "dev:portal": "pnpm --filter @cpa/portal run dev",
    "build": "pnpm --filter @cpa/shared run build && pnpm --filter @cpa/api run build && pnpm --filter @cpa/portal run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed-demo": "ts-node prisma/seed-demo.ts",
    "db:seed-cohort": "ts-node prisma/seed-cohort.ts",
    "db:seed-showcase": "ts-node prisma/seed-showcase.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "prisma": "^5.14.0"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
